rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isPortalUserDoc() {
      // Safely check existence BEFORE reading .data to avoid null-access errors
      // for mobile app users who have no doc in admin_users
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    function isAdmin() {
      return isPortalUserDoc()
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBroker() {
      return isPortalUserDoc()
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'broker';
    }

    function isPortalUser() {
      return isAdmin() || isBroker();
    }

    // ─── PORTAL USERS (admin_users collection) ────────────────────────────────

    match /admin_users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Only admin creates portal users; role cannot be changed from client
      allow create: if isAdmin();
      allow update: if isAdmin() 
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();
    }

    // ─── PLANS ────────────────────────────────────────────────────────────────

    match /plans/{planId} {
      // Any authenticated user (including mobile app users via UID) can read plans
      allow read: if isAuthenticated();
      // Only admin can create/update/delete plans
      allow create, update, delete: if isAdmin();
    }

    // ─── BROKERS ──────────────────────────────────────────────────────────────

    match /brokers/{brokerId} {
      // Admin reads all; broker reads own doc; End-users can read to validate broker code
      allow read: if true;
      // Only admin creates brokers
      allow create: if isAdmin();
      // Admin or broker can update (for stats updates when approving users)
      allow update: if isAdmin() || (isBroker() && request.auth.uid == brokerId);
      allow delete: if isAdmin();
    }

    // ─── REPLYMET END-USERS (the 'users' collection) ──────────────────────────

    match /users/{userId} {
      // Read access:
      // - Single-document GET is open: needed UNAUTHENTICATED for the signup duplicate-check
      //   and login pre-check (`users/{phone}` fetched by exact id before sign-in). Since
      //   userId IS the phone number, a caller can only read a doc whose phone they already
      //   know — there is no enumeration. (Fully removing the unauth GET would require moving
      //   those pre-checks into a Cloud Function.)
      // - LIST/queries are restricted so user PII cannot be mass-enumerated (the old
      //   `allow read: ... || true` permitted exactly that). Admins list all; brokers list
      //   only their own (or unassigned) users; regular mobile users never list.
      allow get: if true;
      allow list: if isAdmin()
        || (isBroker() && (resource.data.brokerId == request.auth.uid || resource.data.brokerId == null || resource.data.brokerId == ''));

      // Create: Registration is done WITHOUT Firebase Auth (anonymous user).
      // Strictly constrain the writable fields and prevent privilege escalation.
      allow create: if request.resource.data.isApproved == false
        && request.resource.data.isBlocked == false
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'isApproved', 'isBlocked',
          'createdAt', 'updatedAt', 'brokerId', 'brokerCode', 'status',
          // registerUser() also seeds these; must be allowed or registration is rejected.
          'authUid', 'fcmToken'
        ]);

      // Update access:
      // - Admin: full update rights
      // - Broker: can update their own users' status/subscription fields only
      //           OR can approve pending users (setting brokerId, plan, etc.)
      // - Authenticated end-users: can only update name, email, fcmToken (NOT approval fields)
      allow update: if isAdmin()
        || (isBroker()
            && (resource.data.brokerId == request.auth.uid
                || resource.data.brokerId == null
                || resource.data.brokerId == '')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'isApproved', 'isBlocked', 'approvedBy', 'approvedByRole',
              'brokerId', 'planId', 'planName', 'subscriptionStart', 'subscriptionEnd',
              'totalPaid', 'brokerCommission', 'adminRevenue', 'updatedAt'
            ])
            && request.resource.data.brokerId == request.auth.uid)
        || (isAuthenticated()
            && (request.auth.uid == userId || request.auth.token.phone_number == userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'email', 'fcmToken', 'authUid', 'updatedAt'
            ])
            // CRITICAL: users cannot self-approve
            && request.resource.data.isApproved == resource.data.isApproved
            && request.resource.data.isBlocked == resource.data.isBlocked);

      // Only admin can delete users
      allow delete: if isAdmin();

      match /subscription_history/{historyId} {
        allow read: if isAdmin()
          || (isBroker() && (get(/databases/$(database)/documents/users/$(userId)).data.brokerId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.brokerId == null || get(/databases/$(database)/documents/users/$(userId)).data.brokerId == ''))
          || (isAuthenticated() && (
               request.auth.uid == userId
            || request.auth.token.phone_number == userId
          ));
        allow create: if isAdmin()
          || (isBroker() && (get(/databases/$(database)/documents/users/$(userId)).data.brokerId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.brokerId == null || get(/databases/$(database)/documents/users/$(userId)).data.brokerId == ''));
        allow update, delete: if isAdmin();
      }
    }

    // ─── BROKERS — allow read of broker codes for validation during signup ────

    match /brokers/{brokerId} {
      // Mobile app users can read broker code for validation (read-only, no sensitive data)
      allow read: if isAuthenticated();
    }

    // ─── APPROVALS ────────────────────────────────────────────────────────────

    match /approvals/{approvalId} {
      // Admin sees all; broker sees own approvals
      allow read: if isAdmin()
        || (isBroker() && resource.data.brokerId == request.auth.uid);

      // Approvals are created by admin or broker (for their own users)
      allow create: if isAdmin()
        || (isBroker() && request.resource.data.brokerId == request.auth.uid);

      // Approvals are immutable audit records
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── ACTIVITY LOGS ────────────────────────────────────────────────────────

    match /activity_logs/{logId} {
      // Admin sees all; others see only own actions
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.performedBy == request.auth.uid);

      // Any authenticated portal user can write their own actions
      allow create: if isPortalUser()
        && request.resource.data.performedBy == request.auth.uid;

      // Logs are immutable
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ─── STATS ────────────────────────────────────────────────────────────────
    
    match /stats/{statDoc} {
      // Admin sees stats (and potentially brokers depending on dashboard visibility)
      allow read: if isPortalUser();
      
      // Only admin or Cloud Functions update stats
      allow create, update, delete: if isAdmin();
    }
  }
}
